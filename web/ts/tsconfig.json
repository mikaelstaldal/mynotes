{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "../static",
    "paths": {
      "preact": ["./third_party/preact/src/index.d.ts"],
      "preact/hooks": ["./third_party/preact/hooks/src/index.d.ts"],
      "preact/jsx-runtime": ["./third_party/preact/jsx-runtime/src/index.d.ts"],
      "codemirror": ["./third_party/codemirror.d.ts"],
      "markdown-it": ["./third_party/node_modules/@types/markdown-it/index.d.mts"],
      "dompurify": ["./third_party/node_modules/dompurify/dist/purify.es.d.mts"],
      "emoji-data": ["./third_party/emoji.d.ts"],
      "lucide-icons": ["./third_party/lucide.d.ts"],
      "asciimath": ["./third_party/asciimath.d.ts"],
      "mermaid": ["./third_party/mermaid.d.ts"]
    },
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["*.ts", "*.tsx", "**/*.ts", "**/*.tsx"],
  "//": [
    "demo/ and demo-sw.ts are the demo service worker: worker code, not DOM code.",
    "They build separately under demo/tsconfig.json (see the comment there)."
  ],
  "exclude": ["third_party", "demo", "demo-sw.ts"]
}
